# Production example. Replace privately before starting; never commit .env.local.
NODE_ENV=production
MONGODB_URI=mongodb://127.0.0.1:27017/stmarys_guwahati_club
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
APP_ORIGIN=https://guwahati-club.example.com
NEXT_PUBLIC_API_URL=/api
UPLOAD_DIR=/var/lib/stmarys-guwahati-club/uploads
TRUST_PROXY_IP=false
# Optional quota, bytes (default 1 GiB); single application process required.
UPLOAD_MAX_BYTES=1073741824
# Only for deliberate provisioning/reset; remove after use.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
